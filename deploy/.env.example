# 复制成 .env（和 docker-compose.yml 放在一起：cp .env.example .env），按自己的填。.env 不进 git（.gitignore 里有）。
# 每一项的意思见 docs/deploy.md「一步步部署」。

# 用哪个反向代理：caddy（自动申请 HTTPS 证书，最省事）或 nginx（用云厂商控制台发的证书，放 deploy/certs/）
COMPOSE_PROFILES=caddy

# 游戏的域名（要已经备案、解析到这台服务器）
SITE_ADDRESS=fs.example.com

# 允许哪些网页连中继：就是上面那个域名，带 https://（有 www 的也写上，逗号分隔）
RELAY_ORIGINS=https://fs.example.com

# 中继的上限（不写就用默认值）：房间数、总连接数、每个 IP 的连接数
# RELAY_MAX_ROOMS=500
# RELAY_MAX_CONNS=2000
# RELAY_MAX_CONNS_PER_IP=24

# 构建镜像时拉 npm 包慢的话，换国内的镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
