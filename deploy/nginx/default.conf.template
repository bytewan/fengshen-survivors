# nginx 正式配置（https）。官方镜像起来时把 ${SERVER_NAME} 换成环境变量的值，写到 /etc/nginx/conf.d/default.conf。
# 证书：云厂商控制台申请的免费证书（下载 nginx 格式），放到 deploy/certs/fullchain.pem 和 deploy/certs/privkey.pem（docker-compose 挂进来）。
# 证书到期前要换新的：换完 docker compose exec nginx nginx -s reload（docs/deploy.md「HTTPS 证书」）。
# 只听 IPv4（Docker 默认的网络里容器没有 IPv6）；服务器要直接对外提供 IPv6 时，每个 listen 下面加一行 listen [::]:端口 …;
# 不用 Docker 的话：把 ${SERVER_NAME} 换成域名、include 的路径换成这份仓库里 fengshen-site.conf 的位置，放进 /etc/nginx/conf.d/。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# http：都跳到 https
server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;
    access_log off;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # 证书稳定、确定以后只走 https 了，再打开（一旦发出去，浏览器一年内都只用 https 访问这个域名）：
    # add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/fengshen-site.conf;
}
