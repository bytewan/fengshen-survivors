# nginx 本机试的配置：只有 http（不用证书）。docker-compose.local.yml 把它挂成模板，盖掉正式的 default.conf.template。
# 页面开 http://localhost:5312/?relay=ws://localhost:5312/relay ——用了非默认端口的 http 页面默认连 :5300（局域网开发的规矩，
# 见 src/net/link.ts 的 relayUrl），所以本机试 nginx 时要用 ?relay= 指到 /relay。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    include /etc/nginx/snippets/fengshen-site.conf;
}
